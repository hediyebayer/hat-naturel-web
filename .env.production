# Production ortam değişkenleri (commit edilir — gizli değer YOK).
# Sadece NEXT_PUBLIC_* (client'a açık) yönetimsel değerler burada tutulur.
# Gizli anahtarlar (API key, ödeme secret vb.) sunucudaki .env.local'da kalmalı.
# Ödeme güvenliği için şu secret'lar SADECE sunucuda tanımlanmalı:
# - CARD_ENCRYPTION_KEY (32-byte base64/hex)
# - VAKIFBANK_STORE_KEY
# - VAKIFBANK_CALLBACK_HASH_REQUIRED=true (önerilen güvenli varsayılan)
# - PAYMENT_STORE_ACKNOWLEDGE_IN_MEMORY_RISK=true yalnızca risk bilinçli kabul edildiyse

# Google Tag Manager (reklamçıdan gelen kurulum)
# Production build'de Next bu değeri inline eder. Değiştirmek için yeniden build gerekir.
NEXT_PUBLIC_GTM_ID=GTM-TBGHC9BP
